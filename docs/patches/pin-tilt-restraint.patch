@@ -126,6 +126,51 @@ def crank(tmp_path_factory):
     return p, b
 
 
+def test_forks_react_the_couple_of_offset_bearing_loads():
+    """A link whose second lug is thinned by a top spot face: equal and opposite pin forces F along x act at bore
+    mid-heights 5 and 3 mm, a couple F x 2 mm about y. With both pins held square by forks, the forks react exactly
+    that and the hold reacts nothing; with neither, the hold has to take it."""
+    from cad_assist.fem.analysis import _hold, bearing_load, bore_tris, tilt_operator
+
+    bar = Pos(40, 0, 5) * Box(80, 20, 10) - Pos(70, 0, 8) * Box(20, 20, 4)
+    part = bar - Pos(10, 0, 5) * Cylinder(4, 12) - Pos(70, 0, 5) * Cylinder(4, 12)
+    mesh = mesh_shape(part, size=2.5)
+    Fx, z = 1000.0, np.array([0.0, 0.0, 1.0])
+    tris = {x: bore_tris(mesh, (x, 0, 5), z, 4.0) for x in (10, 70)}
+    f = bearing_load(mesh, tris[10], (10, 0, 5), z, np.array([-Fx, 0, 0])) + bearing_load(mesh, tris[70], (70, 0, 5), z, np.array([Fx, 0, 0]))
+    # Hand statics: sum r x F about the origin; the load set has no net force.
+    xs = mesh.nodes
+    fv = f.reshape(-1, 3)
+    couple = np.cross(xs, fv).sum(axis=0)
+    assert np.abs(fv.sum(axis=0)).max() < 1e-6 * Fx
+    assert couple[1] == pytest.approx(-2 * Fx, rel=0.02) and abs(couple[0]) < 0.02 * Fx
+
+    tilts = []
+    for x in (10, 70):
+        L, length = tilt_operator(mesh, tris[x], (x, 0, 5), z)
+        tilts.append((L, 10 * E * 8.0 * length ** 2))
+    fixed, released = _hold(mesh, z, tilt=True)
+    sol = solve(mesh, E, NU, f, fixed, tilts=tilts, released=released)
+    assert np.abs(sol.reactions[fixed]).max() < 1e-3 * Fx
+    # Each bore tilts by phi = axis x psi; its fork's moment on the part is the restoring -k phi. Together they balance
+    # the couple.
+    m = sum(-k * np.cross(z, psi[0] * _e1(z) + psi[1] * np.cross(z, _e1(z))) for (_L, k), psi in zip(tilts, sol.tilts))
+    assert m == pytest.approx(-couple, abs=0.01 * Fx)
+    # A rigid in-plane translation and spin of the part are not tilts: the operators ignore them.
+    rigid = np.tile([0.3, -0.2, 0.0], len(mesh.nodes)) + np.column_stack([-xs[:, 1], xs[:, 0], 0 * xs[:, 0]]).ravel() * 1e-3
+    assert all(np.abs(L @ rigid).max() < 1e-9 for L, _k in tilts)
+    # Without forks the 3-2-1 hold reacts the couple: about 2000 N mm over its lever arms.
+    fixed6, _ = _hold(mesh, z, tilt=False)
+    free_sol = solve(mesh, E, NU, f, fixed6)
+    assert np.abs(free_sol.reactions[fixed6]).max() > 10.0
+
+
+def _e1(a):
+    a = np.asarray(a, float)
+    e = np.cross(a, [1, 0, 0]) if abs(a[0]) < 0.9 else np.cross(a, [0, 1, 0])
+    return e / np.linalg.norm(e)
+
+
