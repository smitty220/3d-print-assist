+def tilt_operator(mesh: Mesh, tris: np.ndarray, origin, axis) -> tuple[sp.csr_matrix, float]:
+    """The bore's rigid tilt about the two in-plane axes as a linear map of the displacements, (2, 3N) in rad: a
+    least-squares fit of the bore surface's radial displacement to a rigid pin motion (in-plane translation plus tilt),
+    keeping the tilt part. Translation and ovalisation are left free, so a spring on it reacts only the out-of-plane
+    moment. Rows are psi = phi x axis in (e1, e2), where phi is the tilt vector. Returns it and the bore length (mm)."""
+    a = _unit(axis)
+    o = np.asarray(origin, float)
+    e1 = _unit(np.cross(a, [1, 0, 0]) if abs(a[0]) < 0.9 else np.cross(a, [0, 1, 0]))
+    e2 = np.cross(a, e1)
+    x, _n, w = surface_points(mesh.nodes, tris)  # g-major: index g * F + f
+    F = len(tris)
+    v = x - o
+    h = v @ a
+    rad = v - h[:, None] * a
+    nr = rad / np.linalg.norm(rad, axis=1)[:, None]
+    h = h - (w * h).sum() / w.sum()
+    r = np.stack([nr @ e1, nr @ e2, h * (nr @ e1), h * (nr @ e2)], axis=1)  # regressors per point
+    G = (r * w[:, None]).T @ r
+    coef = (np.linalg.inv(G)[2:4] @ (r * w[:, None]).T).T  # (P, 2): this point's weight in each tilt row
+    rows, cols, vals = [], [], []
+    for g in range(len(TRI_WEIGHTS)):
+        sl = slice(g * F, (g + 1) * F)
+        for j in range(2):
+            for k in range(3):
+                # psi_j += coef[p, j] * nr[p, k] * u_k(x_p), u(x_p) = sum_n N_n(g) u_n
+                c = coef[sl, j] * nr[sl, k]
