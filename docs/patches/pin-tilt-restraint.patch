+                    vals.append(c * TRI_N[g, nn])
+    L = sp.csr_matrix((np.concatenate(vals), (np.concatenate(rows), np.concatenate(cols))), shape=(2, mesh.n_dof))
+    length = float(((x - o) @ a).max() - ((x - o) @ a).min())
+    return L, length
